float automationRiskPct = input.float(0.25, "Requested risk %", minval=0.05, maxval=5.00, step=0.05, group=grpAuto)
int automationTTLSeconds = input.int(120, "Signal expiry (seconds)", minval=30, maxval=900, group=grpAuto)
bool automateAGrade = input.bool(true, "Automate A-grade trades", group=grpAuto)
bool automateBGrade = input.bool(false, "Automate B-grade trades", group=grpAuto)

//=============================================================================
// HELPER FUNCTIONS
//=============================================================================
f_clamp(float value, float minimum, float maximum) =>
    math.max(minimum, math.min(maximum, value))

f_stateText(bool bull, bool bear) =>
    string result = "Neutral"
    if bull and not bear
        result := "Bullish"
    else if bear and not bull
        result := "Bearish"
    result

f_stateColour(bool bull, bool bear) =>
    color result = color.silver
    if bull and not bear
        result := color.lime
    else if bear and not bull
        result := color.red
    result

f_grade(float score) =>
    string result = "D"
    if score >= 88
        result := "A+"
    else if score >= 80
        result := "A"
    else if score >= 70
        result := "B"
    else if score >= 60
        result := "C"
    result

f_scoreColour(float score) =>
    color result = color.red
    if score >= 80
        result := color.lime
    else if score >= 70
        result := color.new(color.lime, 20)
    else if score >= 60
        result := color.orange
    result

//=============================================================================
// LOCAL DATA
//=============================================================================
float ema20 = ta.ema(close, fastLength)
float ema50 = ta.ema(close, midLength)
float ema200 = ta.ema(close, slowLength)

float atrValue = ta.atr(atrLength)
float rsiValue = ta.rsi(close, rsiLength)
[plusDI, minusDI, adxValue] = ta.dmi(diLength, adxSmoothing)

float emaGapATR = math.abs(ema20 - ema50) / math.max(atrValue, syminfo.mintick)
float extensionATR = math.abs(close - ema20) / math.max(atrValue, syminfo.mintick)

bool localBull =
     close > ema20 and
     ema20 > ema50 and
     ema50 > ema200 and
     ema20 > ema20[1]

bool localBear =
     close < ema20 and
     ema20 < ema50 and
     ema50 < ema200 and
     ema20 < ema20[1]

//=============================================================================
// MULTI-TIMEFRAME DATA
// Separate request.security calls are used deliberately for Pine reliability.
//=============================================================================
float execClose = request.security(
     syminfo.tickerid,
     executionTF,
     close,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float execEMA20 = request.security(
     syminfo.tickerid,
     executionTF,
     ta.ema(close, fastLength),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float execEMA50 = request.security(
     syminfo.tickerid,
     executionTF,
     ta.ema(close, midLength),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float execEMA200 = request.security(
     syminfo.tickerid,
     executionTF,
     ta.ema(close, slowLength),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

bool execEMA20Rising = request.security(
     syminfo.tickerid,
     executionTF,
     ta.ema(close, fastLength) > ta.ema(close, fastLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

bool execEMA20Falling = request.security(
     syminfo.tickerid,
     executionTF,
     ta.ema(close, fastLength) < ta.ema(close, fastLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float directionClose = request.security(
     syminfo.tickerid,
     directionTF,
     close,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float directionEMA20 = request.security(
     syminfo.tickerid,
     directionTF,
     ta.ema(close, fastLength),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float directionEMA50 = request.security(
     syminfo.tickerid,
     directionTF,
     ta.ema(close, midLength),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float directionEMA200 = request.security(
     syminfo.tickerid,
     directionTF,
     ta.ema(close, slowLength),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

bool directionEMA20Rising = request.security(
     syminfo.tickerid,
     directionTF,
     ta.ema(close, fastLength) > ta.ema(close, fastLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

bool directionEMA20Falling = request.security(
     syminfo.tickerid,
     directionTF,
     ta.ema(close, fastLength) < ta.ema(close, fastLength)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float macroClose = request.security(
     syminfo.tickerid,
     macroTF,
     close,
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float macroEMA20 = request.security(
     syminfo.tickerid,
     macroTF,
     ta.ema(close, fastLength),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float macroEMA50 = request.security(
     syminfo.tickerid,
     macroTF,
     ta.ema(close, midLength),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float macroEMA200 = request.security(
     syminfo.tickerid,
     macroTF,
     ta.ema(close, slowLength),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

//=============================================================================
// TIMEFRAME STATES
//=============================================================================
bool executionBull =
     execClose > execEMA20 and
     execEMA20 > execEMA50 and
     execEMA50 > execEMA200 and
     execEMA20Rising

bool executionBear =
     execClose < execEMA20 and
     execEMA20 < execEMA50 and
     execEMA50 < execEMA200 and
     execEMA20Falling

bool directionBull =
     directionClose > directionEMA20 and
     directionEMA20 > directionEMA50 and
     directionEMA50 > directionEMA200 and
     directionEMA20Rising

bool directionBear =
     directionClose < directionEMA20 and
     directionEMA20 < directionEMA50 and
     directionEMA50 < directionEMA200 and
     directionEMA20Falling

bool macroBull =
     macroClose > macroEMA200 and
     macroEMA20 > macroEMA50

bool macroBear =
     macroClose < macroEMA200 and
     macroEMA20 < macroEMA50

//=============================================================================
// SESSION STATUS
//=============================================================================
bool londonActive = not na(time(timeframe.period, londonSession, sessionZone))
bool newYorkActive = not na(time(timeframe.period, newYorkSession, sessionZone))
bool overlapActive = londonActive and newYorkActive
bool sessionActive = londonActive or newYorkActive

string sessionText = "Closed"
color sessionColour = color.silver

if overlapActive
    sessionText := "Overlap"
    sessionColour := color.aqua
else if londonActive
    sessionText := "London"
    sessionColour := color.blue
else if newYorkActive
    sessionText := "New York"
    sessionColour := color.orange

//=============================================================================
// 100-POINT CONFLUENCE ENGINE
//=============================================================================
float bullScoreRaw = 0.0
float bearScoreRaw = 0.0

// Local trend — 30 points.
bullScoreRaw += close > ema200 ? 10 : 0
bearScoreRaw += close < ema200 ? 10 : 0

bullScoreRaw += ema20 > ema50 ? 8 : 0
bearScoreRaw += ema20 < ema50 ? 8 : 0

bullScoreRaw += ema50 > ema200 ? 7 : 0
bearScoreRaw += ema50 < ema200 ? 7 : 0

bullScoreRaw += ema20 > ema20[1] ? 5 : 0
bearScoreRaw += ema20 < ema20[1] ? 5 : 0

// Higher timeframes — 36 points.
bullScoreRaw += executionBull ? 14 : 0
bearScoreRaw += executionBear ? 14 : 0

bullScoreRaw += directionBull ? 12 : 0
bearScoreRaw += directionBear ? 12 : 0

bullScoreRaw += macroBull ? 10 : 0
bearScoreRaw += macroBear ? 10 : 0

// Momentum — 22 points.
bullScoreRaw += adxValue >= minimumADX and plusDI > minusDI ? 8 : 0
bearScoreRaw += adxValue >= minimumADX and minusDI > plusDI ? 8 : 0

bullScoreRaw += adxValue >= strongADX ? 4 : 0
bearScoreRaw += adxValue >= strongADX ? 4 : 0

bullScoreRaw += rsiValue > 52 and rsiValue < 72 ? 7 : 0
bearScoreRaw += rsiValue < 48 and rsiValue > 28 ? 7 : 0

bullScoreRaw += emaGapATR >= minimumGapATR ? 3 : 0
bearScoreRaw += emaGapATR >= minimumGapATR ? 3 : 0

// Session — 4 points.
bullScoreRaw += sessionActive ? 4 : 0
bearScoreRaw += sessionActive ? 4 : 0

// Price-location quality — 8 points.
bullScoreRaw += close > ema20 and extensionATR <= maximumExtensionATR ? 8 : 0
bearScoreRaw += close < ema20 and extensionATR <= maximumExtensionATR ? 8 : 0

// Overextension and exhaustion penalties.
if close > ema20 and extensionATR > maximumExtensionATR
    bullScoreRaw -= 10

if close < ema20 and extensionATR > maximumExtensionATR
    bearScoreRaw -= 10

if rsiValue >= 75
    bullScoreRaw -= 8

if rsiValue <= 25
    bearScoreRaw -= 8

float bullScore = f_clamp(bullScoreRaw, 0, 100)
float bearScore = f_clamp(bearScoreRaw, 0, 100)
float scoreEdge = math.abs(bullScore - bearScore)

// Score-adaptive chase protection. Lower grades retain the base limit;
// Grade A and A+ trends receive extra room when enabled.
f_extensionLimit(float directionalScore) =>
    float result = maximumExtensionATR
    if useAdaptiveExtension
        if directionalScore >= 88
            result := math.max(maximumExtensionATR, gradeAPlusExtensionATR)
        else if directionalScore >= 80
            result := math.max(maximumExtensionATR, gradeAExtensionATR)
    result

float bullishExtensionLimitATR = f_extensionLimit(bullScore)
float bearishExtensionLimitATR = f_extensionLimit(bearScore)
bool bullishExtensionOK = extensionATR <= bullishExtensionLimitATR
bool bearishExtensionOK = extensionATR <= bearishExtensionLimitATR
float activeExtensionLimitATR = bullScore >= bearScore ? bullishExtensionLimitATR : bearishExtensionLimitATR

//=============================================================================
// DECISION AND ENTRY ENGINE
//=============================================================================
bool sessionOK = not useSessionFilter or sessionActive
bool extensionOK = extensionATR <= activeExtensionLimitATR

bool bullishBiasReady =
     bullScore >= actionThreshold and
     bullScore > bearScore and
     scoreEdge >= minimumScoreEdge and
     sessionOK

bool bearishBiasReady =
     bearScore >= actionThreshold and
     bearScore > bullScore and
     scoreEdge >= minimumScoreEdge and
     sessionOK

bool bullishCandleOK = not requireCandleConfirmation or close > open
bool bearishCandleOK = not requireCandleConfirmation or close < open

bool executionLongOK = not requireExecutionAlignment or executionBull
bool executionShortOK = not requireExecutionAlignment or executionBear

bool bullishPullbackTouch =
     low <= ema20 + atrValue * pullbackDistanceATR and
     close > ema20

bool bearishPullbackTouch =
     high >= ema20 - atrValue * pullbackDistanceATR and
     close < ema20

bool bullishBreakout =
     allowBreakoutEntry and
     close > high[1] and
     close > ema20 and
     bullishExtensionOK

bool bearishBreakout =
     allowBreakoutEntry and
     close < low[1] and
     close < ema20 and
     bearishExtensionOK

// A-grade trigger: the original high-confluence pullback setup.
bool bullishATrigger =
     (bullishPullbackTouch or bullishBreakout) and
     bullishCandleOK and
     executionLongOK and
     bullishExtensionOK

bool bearishATrigger =
     (bearishPullbackTouch or bearishBreakout) and
     bearishCandleOK and
     executionShortOK and
     bearishExtensionOK

// B-grade bias: slightly lower score requirements, but trend must still agree.
float bGradeThreshold = math.max(actionThreshold - bGradeScoreDiscount, 50)
float bullishBGradeExtensionLimitATR = useAdaptiveExtension and bullScore >= 80 ? math.max(bGradeMaximumExtensionATR, bullishExtensionLimitATR) : bGradeMaximumExtensionATR
float bearishBGradeExtensionLimitATR = useAdaptiveExtension and bearScore >= 80 ? math.max(bGradeMaximumExtensionATR, bearishExtensionLimitATR) : bGradeMaximumExtensionATR

bool bullishBGradeBias =
     enableBGradeEntries and
     bullScore >= bGradeThreshold and
     bullScore > bearScore and
     scoreEdge >= bGradeMinimumEdge and
     sessionOK and
     localBull and
     not executionBear

bool bearishBGradeBias =
     enableBGradeEntries and
     bearScore >= bGradeThreshold and
     bearScore > bullScore and
     scoreEdge >= bGradeMinimumEdge and
     sessionOK and
     localBear and
     not executionBull

bool bullishBGradePullback =
     low <= ema20 + atrValue * bGradePullbackATR and
     close > ema20 and
     close > open and
     close >= close[1]

bool bearishBGradePullback =
     high >= ema20 - atrValue * bGradePullbackATR and
     close < ema20 and
     close < open and
     close <= close[1]

float priorContinuationHigh = ta.highest(high, continuationBreakoutBars)[1]
float priorContinuationLow = ta.lowest(low, continuationBreakoutBars)[1]

bool bullishContinuation =
     close > priorContinuationHigh and
     close > ema20 and
     ema20 > ema50 and
     extensionATR <= bullishBGradeExtensionLimitATR

bool bearishContinuation =
     close < priorContinuationLow and
     close < ema20 and
     ema20 < ema50 and
     extensionATR <= bearishBGradeExtensionLimitATR

bool bullishBTrigger =
     bullishBGradeBias and
     (bullishBGradePullback or bullishContinuation) and
     extensionATR <= bullishBGradeExtensionLimitATR

bool bearishBTrigger =
     bearishBGradeBias and
     (bearishBGradePullback or bearishContinuation) and
     extensionATR <= bearishBGradeExtensionLimitATR

// Backward-compatible combined triggers.
bool bullishTrigger = bullishATrigger or bullishBTrigger
bool bearishTrigger = bearishATrigger or bearishBTrigger


//=============================================================================
// STRUCTURE LEVEL ENGINE
//=============================================================================
float tradePivotHigh = ta.pivothigh(high, structureSwingLeft, structureSwingRight)
float tradePivotLow = ta.pivotlow(low, structureSwingLeft, structureSwingRight)

var float structureHigh1 = na
var float structureHigh2 = na
var float structureHigh3 = na
var float structureLow1 = na
var float structureLow2 = na
var float structureLow3 = na

if not na(tradePivotHigh)
    structureHigh3 := structureHigh2
    structureHigh2 := structureHigh1
    structureHigh1 := tradePivotHigh

if not na(tradePivotLow)
    structureLow3 := structureLow2
    structureLow2 := structureLow1
    structureLow1 := tradePivotLow

f_validLongTarget(float level, float entry, float minimumDistance) =>
    not na(level) and level > entry + minimumDistance

f_validShortTarget(float level, float entry, float minimumDistance) =>
    not na(level) and level < entry - minimumDistance

var int lastSignalBar = na
var int planDirection = 0
var int planStartBar = na
var float planEntry = na
var float planStop = na
var float planTP1 = na
var float planTP2 = na
var float planTP3 = na
var string planStatus = "Waiting"
var string planSetupGrade = "—"
var bool exitWarningIssued = false
var string exitWarningReason = "None"

// Retained trade history. Index 0 is the newest signal.
var array<int> histDirection = array.new_int()
var array<int> histStartBar = array.new_int()
var array<float> histEntry = array.new_float()
var array<float> histStop = array.new_float()
var array<float> histTP1 = array.new_float()
var array<float> histTP2 = array.new_float()
var array<float> histTP3 = array.new_float()
var array<string> histGrade = array.new_string()
var array<float> histBullScore = array.new_float()
var array<float> histBearScore = array.new_float()
var array<float> histADX = array.new_float()
var array<float> histRSI = array.new_float()
var array<string> histStatus = array.new_string()
var array<string> histExitReason = array.new_string()
var array<int> histBars = array.new_int()
var array<bool> histTP1Hit = array.new_bool()
var array<bool> histTP2Hit = array.new_bool()
var array<bool> histTP3Hit = array.new_bool()
var array<bool> histStopHit = array.new_bool()
// Maximum favourable movement measured from the bar AFTER entry through the
// full original plan-expiry window, even when TP3 closes the live plan early.
var array<float> histMaxFavourable = array.new_float()
var array<float> histBeyondTP3 = array.new_float()

f_trimTradeHistory() =>
    if array.size(histDirection) > 50
        array.pop(histDirection)
        array.pop(histStartBar)
        array.pop(histEntry)
        array.pop(histStop)
        array.pop(histTP1)
        array.pop(histTP2)
        array.pop(histTP3)
        array.pop(histGrade)
        array.pop(histBullScore)
        array.pop(histBearScore)
        array.pop(histADX)
