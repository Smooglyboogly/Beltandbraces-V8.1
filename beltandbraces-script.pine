     minval=1,
     maxval=20,
     group=grpStructurePlan)

int structureLookback = input.int(
     120,
     "Structure target lookback bars",
     minval=20,
     maxval=500,
     group=grpStructurePlan)

float stopBufferATR = input.float(
     0.15,
     "Stop buffer beyond swing in ATR",
     minval=0.00,
     maxval=1.50,
     step=0.05,
     group=grpStructurePlan)

float minimumStopATR = input.float(
     0.60,
     "Minimum stop distance in ATR",
     minval=0.20,
     maxval=5.00,
     step=0.05,
     group=grpStructurePlan)

float maximumStructureStopATR = input.float(
     3.00,
