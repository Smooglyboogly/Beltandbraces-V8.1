     minval=0.50,
     maxval=10.00,
     step=0.25,
     group=grpStructurePlan)

float minimumTargetR = input.float(
     0.75,
     "Minimum target distance in R",
     minval=0.25,
     maxval=5.00,
     step=0.25,
     group=grpStructurePlan)

float fallbackTP2R = input.float(
     2.0,
     "Fallback TP2 reward multiple",
     minval=1.0,
