     step=0.25,
     group=grpStructurePlan)

float fallbackTP3R = input.float(
     3.0,
     "Fallback TP3 reward multiple",
     minval=1.5,
     maxval=12.0,
     step=0.25,
     group=grpStructurePlan)

int exitWarningMinimumConditions = input.int(
     2,
