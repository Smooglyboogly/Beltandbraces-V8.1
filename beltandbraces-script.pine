//@version=6
indicator("GoldEdge V8.1 — Fast EMA + Adaptive Extension + MT5 Automation", shorttitle="Belt and braces ", overlay=true, max_labels_count=300, max_boxes_count=50, max_lines_count=50)

//=============================================================================
// V8.1 UPGRADE
// Retains all V8.0 tracking, diagnostics and institutional zones.
// All former EMA20 entry/extension logic now follows the adjustable Fast EMA.
// Adds score-adaptive extension limits so Grade A/A+ trends can enter farther from Fast EMA.
//=============================================================================

// INPUT GROUPS
string grpTF       = "01 — Timeframes"
string grpEMA      = "02 — EMA Trend"
string grpMomentum = "03 — Momentum"
string grpDecision = "04 — Decision Engine"
string grpEntry    = "05 — Entry Engine"
string grpRisk     = "06 — Safe Trade Planner"
string grpExit     = "07 — Exit Warning"
string grpZones    = "08 — AI Dashboard + Zones"
string grpStructurePlan = "09 — Structure Trade Engine"
string grpSession  = "10 — Sessions"
string grpVisuals  = "11 — Visuals"
string grpAuto = "AUTOMATION — MT5 BRIDGE"
string grpPsych     = "12 — Psychological Levels"
string grpInstitutional = "13 — Institutional Zones + Review"

// TIMEFRAMES
string executionTF = input.timeframe("5", "Execution timeframe", group=grpTF)
string directionTF = input.timeframe("60", "Directional timeframe", group=grpTF)
string macroTF     = input.timeframe("15", "Macro timeframe", group=grpTF)

// EMA TREND
int fastLength = input.int(9, "Fast EMA", minval=1, group=grpEMA)
int midLength  = input.int(21, "Medium EMA", minval=2, group=grpEMA)
int slowLength = input.int(50, "Slow EMA", minval=3, group=grpEMA)
int atrLength  = input.int(14, "ATR length", minval=1, group=grpEMA)

float minimumGapATR = input.float(
     0.08,
     "Minimum Fast/Medium EMA separation in ATR",
     minval=0.0,
     maxval=3.0,
     step=0.01,
     group=grpEMA)

// MOMENTUM
int rsiLength = input.int(14, "RSI length", minval=2, group=grpMomentum)
int diLength = input.int(14, "DI length", minval=2, group=grpMomentum)
int adxSmoothing = input.int(14, "ADX smoothing", minval=2, group=grpMomentum)

