// INSTITUTIONAL ZONES + REVIEW
bool enableInstitutionalZones = input.bool(true, "Use institutional confluence zones", group=grpInstitutional)
float institutionalZoneWidth = input.float(4.0, "Zone width ($)", minval=0.5, maxval=20.0, step=0.5, group=grpInstitutional)
float institutionalEntryInset = input.float(0.5, "Preferred entry inset ($)", minval=0.0, maxval=5.0, step=0.1, group=grpInstitutional)
int suggestedLayers = input.int(3, "Suggested layers", minval=1, maxval=6, group=grpInstitutional)
float institutionalPsychStep = input.float(5.0, "Institutional psychological spacing ($)", minval=1.0, maxval=100.0, step=1.0, group=grpInstitutional)
float confluenceToleranceATR = input.float(0.35, "Confluence tolerance in ATR", minval=0.05, maxval=2.0, step=0.05, group=grpInstitutional)
bool showLayerLines = input.bool(true, "Show first three suggested layer lines", group=grpInstitutional)
bool manualCloseCurrentTrade = input.bool(false, "MANUAL CLOSE current trade (turn off after use)", group=grpInstitutional)


// PRACTICAL GOLD TARGETS
float firstTargetDollars = input.float(
