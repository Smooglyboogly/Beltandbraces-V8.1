float tp1R = input.float(1.0, "TP1 reward multiple", minval=0.5, maxval=5.0, step=0.25, group=grpRisk)
float tp2R = input.float(2.0, "TP2 reward multiple", minval=0.5, maxval=8.0, step=0.25, group=grpRisk)
